# Enable Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # సబ్‌ఫోల్డర్‌కి అనుగుణంగా RewriteBase మార్చబడింది
    RewriteBase /nivis_lab/

    # Direct access to .git, tools, tests, .vscode prevent చేయడం
    RewriteRule (^|/)\.git(?:/|$) - [F,L,NC]
    RewriteRule ^(?:tools|tests|\.vscode)(?:/|$) - [F,L,NC]

    # Keep checkout route canonical without trailing slash
    RewriteRule ^checkout/$ checkout [R=301,L,NC]

    # 1. REMOVE .PHP EXTENSION (301 Redirect)
    # URL లో నేరుగా .php టైప్ చేస్తే దాన్ని తీసివేసి క్లీన్ URL కి పంపుతుంది
    RewriteCond %{THE_REQUEST} ^GET\ /nivis_lab/([^\s]+)\.php [NC]
    RewriteRule ^(.*)\.php$ $1 [R=301,L,NE]

    # 2. INTERNAL REWRITE FOR PHP FILES
    # extension లేకుండా టైప్ చేసినప్పుడు బ్యాక్‌ఎండ్‌లో .php ఫైల్ ఉంటే లోడ్ చేస్తుంది
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]

    # 3. SPECIFIC DYNAMIC ROUTES (Prefixes added to prevent conflict)
    # newsletter & blog గందరగోళం లేకుండా prefix లు చేర్చబడ్డాయి
    RewriteRule ^newsletter/([a-zA-Z0-9-]+)/?$ newsletter.php?slug=$1 [L,QSA]
    RewriteRule ^blog/([a-zA-Z0-9_-]+)/?$ fullblog.php?id=$1 [L,QSA]
</IfModule>

# ============================================
# SECURITY & OPTIMIZATION
# ============================================

# Protect sensitive files (Shiprocket & Hidden files)
<IfModule mod_authz_core.c>
    <FilesMatch "^(\.git|shiprocket_config\.php)">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^(\.git|shiprocket_config\.php)">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Prevent directory listing
Options -Indexes

# Character encoding
AddDefaultCharset UTF-8

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript
</IfModule>

