# Enable Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /nivis_lab/

    # Direct access to .git, tools, tests, .vscode prevent చేయడం
    RewriteRule (^|/)\.git(?:/|$) - [F,L,NC]
    RewriteRule ^(?:tools|tests|\.vscode)(?:/|$) - [F,L,NC]

    # Keep checkout route canonical without trailing slash
    RewriteRule ^checkout/$ checkout [R=301,L,NC]

    # 1. REMOVE .PHP EXTENSION (301 Redirect) - Fixed Absolute Path
    # URL లో .php తో వస్తే /nivis_lab/ ఫుల్ పాత్‌తో .php లేని URL కి పంపుతుంది
    RewriteCond %{THE_REQUEST} \s/nivis_lab/([^\s]+)\.php[\s?] [NC]
    RewriteRule ^(.*)\.php$ /nivis_lab/$1 [R=301,L,NE]

    # 2. INTERNAL REWRITE FOR PHP FILES
    # .php లేకుండా టైప్ చేస్తే బ్యాక్‌ఎండ్‌లో .php ఫైల్ ఉంటే లోడ్ చేస్తుంది
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]

    # 3. SPECIFIC DYNAMIC ROUTES
    RewriteRule ^newsletter/([a-zA-Z0-9-]+)/?$ newsletter.php?slug=$1 [L,QSA]
    RewriteRule ^blog/([a-zA-Z0-9_-]+)/?$ fullblog.php?id=$1 [L,QSA]
</IfModule>

# ============================================
# SECURITY & OPTIMIZATION
# ============================================

# Protect sensitive files (Shiprocket & Hidden files)
<IfModule mod_authz_core.c>
    <FilesMatch "^(\.git|shiprocket_config\.php)">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^(\.git|shiprocket_config\.php)">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Prevent directory listing
Options -Indexes

# Character encoding
AddDefaultCharset UTF-8

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript
</IfModule>